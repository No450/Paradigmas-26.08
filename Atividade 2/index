#include <stdio.h>
#include <stdbool.h>
#include <locale.h>

int main()
{
    float saldo = 1000, deposito, consultaSaldo, sacar;
    int escolha, cont;
    float resultado;
    bool condicao = false;

    printf("============== CAIXA ELETRONICO ============");

    while (condicao == false)
    {
        printf("\n[1] ConsultarSaldo\n");
        printf("[2] Depositar\n");
        printf("[3] Sacar\n");
        printf("[4] Encerrar\n");
        printf("Escolha: ");
        scanf("%d", &escolha);

        if (escolha == 1)
        {
            printf("\nSaldo: R$ %.2f\n", saldo);
        }

        else if (escolha == 2)
        {
            printf("Deposito: ");
            scanf("%f", &deposito);

            saldo = saldo + deposito;

            printf("\nO seu deposito de R$ %.2f foi adicionado!\n", deposito);
            printf("Total restante: R$ %.2f\n", saldo);
        }

        else if (escolha == 3)
        {
            printf("Sacar: ");
            scanf("%f", &sacar);

            if (sacar <= saldo)
            {
                saldo = saldo - sacar;

                printf("\nO seu saque de R$ %.2f foi retirado!\n", sacar);
                printf("Total restante: R$ %.2f\n", saldo);
            }
            else
            {
                printf("\nSaldo insuficiente!\n");
            }
        }

        else if (escolha == 4)
        {
            condicao = true;
            printf("\nEncerrado...\n");
        }

        else
        {
            printf("\nOpcao invalida\n");
        }

        printf("\n============================================\n");
    }

    return 0;
}
